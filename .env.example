# Chinese and English analysis (/zh and /en). Server-side only; never expose this key to the browser.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Shared cap across all AI requests.
AI_DAILY_REQUEST_LIMIT=250

# WeChat Mini Program login. Server-side only.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# Generate a dedicated random secret of at least 32 characters.
MINI_SESSION_SECRET=
# Stable subject derivation key. Keep separate from MINI_SESSION_SECRET and do not rotate casually.
WECHAT_SUBJECT_SECRET=
# Development only. Marked Mini Program requests require a valid wx.login session in production.
ALLOW_MINI_ANONYMOUS_FALLBACK=true

# Stripe one-time 30-credit pack
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Trusted canonical origin used for social metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000

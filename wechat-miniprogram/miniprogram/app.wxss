page {
  min-height: 100%;
  background: #f4f1e8;
  color: #17352b;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 30rpx;
}

button {
  font: inherit;
}

button::after {
  border: 0;
}

.page-shell {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 36rpx 32rpx 72rpx;
}

.brand-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.brand-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #164f3b;
  color: #f4f1e8;
  font-family: Georgia, serif;
  font-size: 34rpx;
  font-weight: 700;
}

.brand-name {
  font-family: Georgia, "Songti SC", serif;
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.brand-note {
  margin-top: 4rpx;
  color: #6a756f;
  font-size: 21rpx;
  letter-spacing: 1rpx;
}

.eyebrow {
  color: #2d6b53;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.section-title {
  margin: 0;
  color: #17352b;
  font-family: Georgia, "Songti SC", serif;
  font-size: 42rpx;
  font-weight: 600;
  line-height: 1.35;
}

.card {
  box-sizing: border-box;
  border: 1rpx solid rgba(22, 79, 59, 0.18);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.52);
  box-shadow: 0 16rpx 44rpx rgba(37, 55, 46, 0.05);
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 96rpx;
  border-radius: 48rpx;
  background: #164f3b;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.primary-button[disabled] {
  background: #8da197;
  color: rgba(255, 255, 255, 0.8);
}

.secondary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  border: 1rpx solid rgba(22, 79, 59, 0.25);
  border-radius: 44rpx;
  background: transparent;
  color: #164f3b;
  font-weight: 700;
}

.muted {
  color: #69756f;
}

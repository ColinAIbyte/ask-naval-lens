.home-page {
  overflow: hidden;
}

.hero {
  padding: 76rpx 4rpx 54rpx;
}

.hero-title {
  margin-top: 22rpx;
  color: #171814;
  font-family: Georgia, "Songti SC", serif;
  font-size: 66rpx;
  font-weight: 600;
  line-height: 1.22;
  letter-spacing: -2rpx;
}

.hero-title text {
  color: #2d6b53;
}

.hero-copy {
  margin-top: 30rpx;
  color: #4f5d56;
  font-size: 29rpx;
  line-height: 1.85;
}

.trust-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 34rpx;
}

.trust-row view {
  padding: 13rpx 20rpx;
  border-radius: 30rpx;
  background: #dce7df;
  color: #245c46;
  font-size: 23rpx;
  font-weight: 600;
}

.disclaimer {
  margin-top: 24rpx;
  color: #7a817d;
  font-size: 22rpx;
  line-height: 1.65;
}

.question-card {
  padding: 36rpx 30rpx 32rpx;
}

.question-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.question-title {
  margin-top: 10rpx;
  color: #17352b;
  font-family: Georgia, "Songti SC", serif;
  font-size: 38rpx;
  font-weight: 600;
}

.quota-pill {
  flex: none;
  padding: 12rpx 16rpx;
  border-radius: 24rpx;
  background: #d8ef9d;
  color: #164f3b;
  font-size: 21rpx;
  font-weight: 700;
}

.question-input {
  box-sizing: border-box;
  width: 100%;
  height: 350rpx;
  margin-top: 34rpx;
  padding: 26rpx;
  border: 2rpx solid rgba(22, 79, 59, 0.22);
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.7);
  color: #172b24;
  font-size: 29rpx;
  line-height: 1.7;
}

.question-placeholder {
  color: #939a96;
}

.input-meta {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
  color: #7b837f;
  font-size: 21rpx;
}

.topic-heading {
  margin-top: 36rpx;
  color: #43554d;
  font-size: 24rpx;
  font-weight: 700;
}

.topic-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 18rpx;
}

.topic-chip {
  min-height: 72rpx;
  margin: 0;
  padding: 0 24rpx;
  border: 2rpx solid rgba(22, 79, 59, 0.16);
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.64);
  color: #4b5c54;
  font-size: 25rpx;
  line-height: 72rpx;
}

.topic-chip.is-active {
  border-color: #164f3b;
  background: #164f3b;
  color: #ffffff;
  font-weight: 700;
}

.error-panel {
  margin-top: 26rpx;
  padding: 20rpx 22rpx;
  border-left: 6rpx solid #a44d3f;
  border-radius: 12rpx;
  background: #f4e4df;
  color: #813b30;
  font-size: 24rpx;
  line-height: 1.55;
}

.privacy-consent {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 26rpx;
}

.consent-toggle {
  display: flex;
  flex: 1;
  align-items: flex-start;
  gap: 12rpx;
  min-height: 72rpx;
  margin: 0;
  padding: 12rpx 0;
  background: transparent;
  color: #69756f;
  font-size: 21rpx;
  line-height: 1.5;
  text-align: left;
}

.consent-toggle > text {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 34rpx;
  height: 34rpx;
  margin-top: 1rpx;
  border: 2rpx solid #2d6b53;
  border-radius: 7rpx;
  color: #2d6b53;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 30rpx;
}

.privacy-link {
  flex: none;
  min-height: 72rpx;
  margin: 0;
  padding: 0 8rpx;
  background: transparent;
  color: #2d6b53;
  font-size: 21rpx;
  line-height: 72rpx;
  text-decoration: underline;
}

.analyze-button {
  margin-top: 22rpx;
}

.loading-note {
  margin-top: 16rpx;
  color: #6d7772;
  font-size: 22rpx;
  text-align: center;
}

.examples-section {
  padding: 82rpx 0 20rpx;
}

.examples-section .section-title {
  margin-top: 12rpx;
  margin-bottom: 28rpx;
}

.example-card {
  box-sizing: border-box;
  width: 100%;
  min-height: 0;
  margin: 0 0 18rpx;
  padding: 26rpx 28rpx;
  border: 1rpx solid rgba(22, 79, 59, 0.16);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.48);
  color: #17352b;
  line-height: 1.5;
  text-align: left;
}

.example-card > view:first-child {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.example-card > view:first-child text {
  color: #77a052;
  font-family: monospace;
  font-size: 21rpx;
}

.example-label {
  font-size: 28rpx;
  font-weight: 700;
}

.example-question {
  margin-top: 14rpx;
  color: #647069;
  font-size: 24rpx;
  line-height: 1.65;
}

.example-action {
  margin-top: 14rpx;
  color: #2d6b53;
  font-size: 23rpx;
  font-weight: 700;
}

.method-card {
  margin-top: 52rpx;
  padding: 36rpx 28rpx;
}

.method-item {
  display: flex;
  gap: 22rpx;
  padding: 28rpx 0;
  border-bottom: 1rpx solid rgba(22, 79, 59, 0.12);
}

.method-item:last-child {
  padding-bottom: 0;
  border-bottom: 0;
}

.method-item > text {
  color: #89a45b;
  font-family: monospace;
  font-size: 22rpx;
}

.method-title {
  color: #17352b;
  font-size: 27rpx;
  font-weight: 700;
}

.method-copy {
  margin-top: 8rpx;
  color: #69756f;
  font-size: 23rpx;
  line-height: 1.6;
}

.footer {
  padding-top: 70rpx;
  color: #818884;
  font-size: 21rpx;
  text-align: center;
}

.footer-link {
  display: inline-block;
  min-height: 76rpx;
  margin: 0 0 12rpx;
  padding: 0 24rpx;
  background: transparent;
  color: #2d6b53;
  font-size: 23rpx;
  line-height: 76rpx;
}

.about-hero {
  padding: 74rpx 4rpx 48rpx;
}

.about-title {
  margin-top: 20rpx;
  color: #171814;
  font-family: Georgia, "Songti SC", serif;
  font-size: 56rpx;
  font-weight: 600;
  line-height: 1.3;
}

.about-title text {
  color: #2d6b53;
}

.about-copy {
  margin-top: 26rpx;
  color: #59665f;
  font-size: 27rpx;
  line-height: 1.8;
}

.about-card {
  margin-top: 22rpx;
  padding: 30rpx 28rpx;
}

.card-number {
  color: #86a655;
  font-family: monospace;
  font-size: 21rpx;
}

.card-title {
  margin-top: 12rpx;
  color: #17352b;
  font-family: Georgia, "Songti SC", serif;
  font-size: 34rpx;
  font-weight: 600;
}

.card-copy {
  margin-top: 16rpx;
  color: #626e67;
  font-size: 25rpx;
  line-height: 1.8;
}

.contact-card {
  margin-top: 48rpx;
  padding: 34rpx 28rpx;
  border-radius: 28rpx;
  background: #164f3b;
  color: #ffffff;
}

.contact-card .eyebrow {
  color: #d8ef9d;
}

.contact-title {
  margin-top: 14rpx;
  font-family: Georgia, "Songti SC", serif;
  font-size: 36rpx;
  font-weight: 600;
}

.contact-copy {
  margin: 16rpx 0 26rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 24rpx;
}

.contact-card .primary-button {
  background: #d8ef9d;
  color: #164f3b;
}

.contact-card .secondary-button {
  margin-top: 14rpx;
  border-color: rgba(255, 255, 255, 0.35);
  color: #ffffff;
}

.version-note {
  padding-top: 56rpx;
  color: #848b87;
  font-size: 21rpx;
  text-align: center;
}

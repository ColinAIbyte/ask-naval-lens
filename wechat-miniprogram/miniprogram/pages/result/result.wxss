.result-intro {
  padding: 64rpx 4rpx 38rpx;
}

.original-question {
  margin-top: 18rpx;
  color: #4c5b54;
  font-size: 27rpx;
  line-height: 1.75;
}

.state-panel {
  padding: 160rpx 20rpx 80rpx;
  text-align: center;
}

.state-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto;
  border-radius: 50%;
  background: #164f3b;
  color: #ffffff;
  font-family: Georgia, serif;
  font-size: 42rpx;
}

.state-title {
  margin-top: 28rpx;
  font-family: Georgia, "Songti SC", serif;
  font-size: 40rpx;
  font-weight: 600;
}

.state-copy {
  margin: 18rpx 0 36rpx;
  color: #6b7670;
  font-size: 25rpx;
  line-height: 1.7;
}

.error-state .secondary-button {
  margin-top: 18rpx;
}

.judgment-card {
  padding: 38rpx 30rpx;
  border-radius: 28rpx;
  background: #164f3b;
  color: #ffffff;
  box-shadow: 0 20rpx 50rpx rgba(22, 79, 59, 0.18);
}

.section-number {
  color: #d8ef9d;
  font-family: monospace;
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.section-number.light {
  color: rgba(255, 255, 255, 0.64);
}

.core-problem {
  margin-top: 18rpx;
  font-family: Georgia, "Songti SC", serif;
  font-size: 42rpx;
  font-weight: 600;
  line-height: 1.5;
}

.context-note,
.safety-note {
  margin-top: 26rpx;
  padding: 20rpx 22rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.09);
  color: rgba(255, 255, 255, 0.82);
  font-size: 24rpx;
  line-height: 1.7;
}

.context-label {
  margin-bottom: 8rpx;
  color: #d8ef9d;
  font-weight: 700;
}

.judgment-divider {
  height: 1rpx;
  margin: 32rpx 0;
  background: rgba(255, 255, 255, 0.18);
}

.lens-judgment {
  margin-top: 16rpx;
  color: rgba(255, 255, 255, 0.94);
  font-size: 29rpx;
  line-height: 1.85;
}

.result-section {
  padding-top: 82rpx;
}

.result-section .section-title {
  margin-top: 12rpx;
}

.framework-card {
  margin-top: 28rpx;
  padding: 30rpx 26rpx;
}

.framework-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid rgba(22, 79, 59, 0.14);
}

.framework-head text {
  color: #8aa75a;
  font-family: monospace;
  font-size: 21rpx;
}

.framework-head view {
  color: #17352b;
  font-family: Georgia, "Songti SC", serif;
  font-size: 33rpx;
  font-weight: 600;
}

.framework-block {
  padding: 24rpx 0 0;
}

.framework-label {
  color: #2c5f4b;
  font-size: 23rpx;
  font-weight: 700;
}

.framework-text {
  margin-top: 10rpx;
  color: #59665f;
  font-size: 26rpx;
  line-height: 1.75;
}

.framework-block.applied {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #e8eee9;
}

.framework-block.limitation {
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed rgba(22, 79, 59, 0.2);
}

.source-list {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(22, 79, 59, 0.14);
}

.source-label {
  margin-bottom: 14rpx;
  color: #6a756f;
  font-size: 22rpx;
  font-weight: 700;
}

.source-button {
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
  margin: 0 0 12rpx;
  padding: 16rpx 20rpx;
  border-radius: 14rpx;
  background: rgba(22, 79, 59, 0.06);
  color: #245c46;
  line-height: 1.45;
  text-align: left;
}

.source-button view {
  font-size: 24rpx;
  font-weight: 600;
}

.source-button text {
  color: #819087;
  font-size: 20rpx;
}

.action-card {
  display: flex;
  gap: 22rpx;
  margin-top: 24rpx;
  padding: 28rpx 24rpx;
  border: 1rpx solid rgba(22, 79, 59, 0.14);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.5);
}

.action-number {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #d8ef9d;
  color: #164f3b;
  font-family: monospace;
  font-weight: 700;
}

.action-content {
  min-width: 0;
}

.action-title {
  color: #17352b;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.55;
}

.action-why {
  margin-top: 12rpx;
  color: #66726b;
  font-size: 24rpx;
  line-height: 1.7;
}

.action-meta {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(22, 79, 59, 0.1);
}

.action-meta-label {
  color: #2d6b53;
  font-size: 21rpx;
  font-weight: 700;
}

.action-meta > view:last-child {
  margin-top: 6rpx;
  color: #59665f;
  font-size: 23rpx;
  line-height: 1.6;
}

.followup-button {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  width: 100%;
  min-height: 96rpx;
  margin: 20rpx 0 0;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid rgba(22, 79, 59, 0.16);
  border-radius: 0;
  background: transparent;
  color: #17352b;
  font-size: 25rpx;
  line-height: 1.55;
  text-align: left;
}

.followup-button text {
  padding-right: 24rpx;
}

.followup-arrow {
  color: #75a050;
  font-size: 32rpx;
  font-weight: 700;
}

.feedback-card {
  margin-top: 76rpx;
  padding: 28rpx;
}

.feedback-title {
  color: #17352b;
  font-size: 26rpx;
  font-weight: 700;
  text-align: center;
}

.feedback-buttons {
  display: flex;
  gap: 14rpx;
  margin-top: 22rpx;
}

.feedback-button {
  flex: 1;
  min-height: 76rpx;
  margin: 0;
  border: 1rpx solid rgba(22, 79, 59, 0.16);
  border-radius: 38rpx;
  background: transparent;
  color: #5c6962;
  font-size: 23rpx;
  line-height: 76rpx;
}

.feedback-button.active {
  background: #dce7df;
  color: #164f3b;
  font-weight: 700;
}

.share-card {
  margin-top: 30rpx;
  padding: 30rpx 26rpx;
  border-radius: 24rpx;
  background: #d8ef9d;
}

.share-title {
  color: #164f3b;
  font-size: 29rpx;
  font-weight: 700;
}

.share-note {
  margin: 12rpx 0 24rpx;
  color: #42604e;
  font-size: 23rpx;
  line-height: 1.65;
}

.another-button {
  margin-top: 24rpx;
}

.result-disclaimer {
  padding: 48rpx 12rpx 4rpx;
  color: #7c8580;
  font-size: 21rpx;
  line-height: 1.7;
  text-align: center;
}
